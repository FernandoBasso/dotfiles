// Zed keymap
//
// For information on binding keys, see the Zed
// documentation: https://zed.dev/docs/key-bindings
//
// To see the default key bindings run `zed: open default keymap`
// from the command palette.
[
  {
    "context": "Workspace",
    "bindings": {
      // "shift shift": "file_finder::Toggle"
    },
  },
  {
    "context": "Editor && vim_mode == insert",
    "bindings": {
      // "j k": "vim::NormalBefore"
    },
  },
  {
    "context": "Workspace",
    "bindings": {
      "ctrl-;": "workspace::Save"
    }
  },
  {
    "context": "Editor",
    "unbind": {
      "ctrl-;": "editor::ToggleLineNumbers"
    }
  },
  {
    "context": "Editor && mode == full",
    "bindings": {
      "ctrl-[ n": "editor::GoToNextChange"
    }
  },
  {
    "context": "Editor && mode == full",
    "bindings": {
      "ctrl-[ p": "editor::GoToPreviousChange"
    }
  },
  {
    "context": "Editor && mode == full",
    "unbind": {
      "ctrl-alt-shift-backspace": "editor::GoToNextChange"
    }
  },
  {
    "context": "Editor && mode == full",
    "unbind": {
      "ctrl-shift-backspace": "editor::GoToPreviousChange"
    }
  },
  {
    "context": "Workspace",
    "bindings": {
      "ctrl-k h": "workspace::ActivatePaneLeft"
    }
  },
  {
    "context": "Workspace",
    "unbind": {
      "ctrl-k ctrl-left": "workspace::ActivatePaneLeft"
    }
  },
  {
    "context": "Workspace",
    "bindings": {
      "ctrl-k l": "workspace::ActivatePaneRight"
    }
  },
  {
    "context": "Workspace",
    "unbind": {
      "ctrl-k ctrl-right": "workspace::ActivatePaneRight"
    }
  },
  {
    "context": "Workspace",
    "unbind": {
      "ctrl-j": "workspace::ToggleBottomDock"
    }
  },
  {
    "bindings": {
      "ctrl-k ctrl-y": "editor::InsertSnippet"
    }
  },
  {
    "context": "GitPanel && ChangesList && !GitBranchSelector && !GitRepositorySelector",
    "bindings": {
      "ctrl-k shift-p": "workspace::CopyPath"
    }
  },
  {
    "bindings": {
      "ctrl-k shift-p": "editor::CopyPermalinkToLine"
    }
  },
  {
    "context": "Editor",
    "unbind": {
      "ctrl-k p": "workspace::CopyPath"
    }
  },
  {
    "context": "GitPanel && ChangesList && !GitBranchSelector && !GitRepositorySelector || Editor",
    "bindings": {
      "ctrl-k p": "workspace::CopyRelativePath"
    }
  },
  {
    "context": "Editor || Workspace",
    "bindings": {
      "alt-g m": "git::OpenModifiedFiles"
    }
  }
]
