[
  {
    "key": "escape",
    "command": "extension.vim_escape",
    "when": "editorTextFocus && vim.active && !inDebugRepl && !inlineSuggestionVisible && !dirtyDiffVisible"
  },
  {
    "key": "escape",
    "command": "-extension.vim_escape",
    "when": "editorTextFocus && vim.active && !inDebugRepl"
  },
  {
    "key": "alt+cmd+-",
    "command": "workbench.action.focusActiveEditorGroup",
    "when": "terminalFocus"
  },
  {
    "key": "alt+cmd+-",
    "command": "terminal.focus",
    "when": "editorTextFocus"
  },
  {
    "key": "ctrl+shift+alt+]",
    "command": "-jupyter.extendSelectionByCellBelow",
    "when": "editorTextFocus && jupyter.hascodecells && !notebookEditorFocused"
  },
  {
    "key": "ctrl+alt+]",
    "command": "editor.action.marker.next",
    "when": "editorFocus"
  },
  {
    "key": "alt+f8",
    "command": "-editor.action.marker.next",
    "when": "editorFocus"
  },
  {
    "key": "f8",
    "command": "-editor.action.marker.nextInFiles",
    "when": "editorFocus"
  },
  {
    "key": "ctrl+shift+alt+[",
    "command": "-jupyter.extendSelectionByCellAbove",
    "when": "editorTextFocus && jupyter.hascodecells && !notebookEditorFocused"
  },
  {
    "key": "ctrl+alt+[",
    "command": "editor.action.marker.prev",
    "when": "editorFocus"
  },
  {
    "key": "shift+alt+f8",
    "command": "-editor.action.marker.prev",
    "when": "editorFocus"
  },
  {
    "key": "shift+alt+k",
    "command": "editor.action.showHover",
    "when": "editorTextFocus"
  },
  {
    "key": "cmd+k cmd+i",
    "command": "-editor.action.showHover",
    "when": "editorTextFocus"
  },
  {
    "key": "shift+k",
    "command": "editor.debug.action.showDebugHover",
    "when": "editorTextFocus && inDebugMode"
  },
  {
    "key": "cmd+k cmd+i",
    "command": "-editor.debug.action.showDebugHover",
    "when": "editorTextFocus && inDebugMode"
  },
  {
    "key": "ctrl+shift+]",
    "command": "-markdown.extension.editing.toggleHeadingUp",
    "when": "editorTextFocus && !editorReadonly && editorLangId == 'markdown'"
  },
  {
    "key": "ctrl+shift+[",
    "command": "-markdown.extension.editing.toggleHeadingDown",
    "when": "editorTextFocus && !editorReadonly && editorLangId == 'markdown'"
  },
  {
    "key": "shift+alt+l",
    "command": "workbench.action.focusNextGroup"
  },
  {
    "key": "cmd+k d",
    "command": "editor.action.insertSnippet",
    "when": "editorTextFocus",
    "args": {
      "snippet": "$CURRENT_YEAR-$CURRENT_MONTH-$CURRENT_DATE"
    }
  },
  {
    // Insert line “TAGS: YYYY-MM-DD”
    "key": "cmd+k t",
    "command": "editor.action.insertSnippet",
    "when": "editorTextFocus",
    "args": {
      "snippet": "TAGS: $CURRENT_YEAR-$CURRENT_MONTH-$CURRENT_DATE"
    }
  },
  {
    "key": "ctrl+alt+]",
    "command": "-jupyter.gotoNextCellInFile",
    "when": "editorTextFocus && jupyter.hascodecells && !notebookEditorFocused"
  },
  {
    "key": "ctrl+h n",
    "command": "workbench.action.editor.nextChange",
    "when": "editorTextFocus"
  },
  {
    "key": "alt+f5",
    "command": "-workbench.action.editor.nextChange",
    "when": "editorTextFocus"
  },
  {
    "key": "ctrl+h p",
    "command": "workbench.action.editor.previousChange",
    "when": "editorTextFocus"
  },
  {
    "key": "shift+alt+f5",
    "command": "-workbench.action.editor.previousChange",
    "when": "editorTextFocus"
  },
  {
    "key": "ctrl+shift+cmd+l",
    "command": "workbench.action.focusRightGroup"
  },
  {
    "key": "cmd+k cmd+right",
    "command": "-workbench.action.focusRightGroup"
  },
  {
    "key": "ctrl+shift+cmd+h",
    "command": "workbench.action.focusLeftGroup"
  },
  {
    "key": "cmd+k cmd+left",
    "command": "-workbench.action.focusLeftGroup"
  },
  {
    "key": "cmd+k cmd+k",
    "command": "-editor.action.selectFromAnchorToCursor",
    "when": "editorTextFocus && selectionAnchorSet"
  },
  {
    "key": "cmd+k cmd+k",
    "command": "-editor.action.defineKeybinding",
    "when": "editorTextFocus && !editorReadonly && editorLangId == 'jsonc'"
  },
  {
    "key": "cmd+k cmd+k",
    "command": "git.stageSelectedRanges",
    "when": "isInDiffEditor"
  },
  {
    "key": "cmd+k cmd+k",
    "command": "git.stageSelectedRanges",
    "when": "editorFocus"
  },
  {
    "key": "cmd+k alt+cmd+s",
    "command": "-git.stageSelectedRanges",
    "when": "isInDiffEditor"
  },
  {
    "key": "cmd+k cmd+n",
    "command": "git.unstageSelectedRanges",
    "when": "isInDiffEditor"
  },
  {
    "key": "cmd+k cmd+n",
    "command": "-git.unstageSelectedRanges",
    "when": "isInDiffEditor"
  },
  {
    "key": "ctrl+h ctrl+n",
    "command": "editor.action.dirtydiff.next",
    "when": "editorTextFocus && !textCompareEditorActive"
  },
  {
    "key": "alt+f3",
    "command": "-editor.action.dirtydiff.next",
    "when": "editorTextFocus && !textCompareEditorActive"
  },
  {
    "key": "ctrl+h ctrl+p",
    "command": "editor.action.dirtydiff.previous",
    "when": "editorTextFocus && !textCompareEditorActive"
  },
  {
    "key": "shift+alt+f3",
    "command": "-editor.action.dirtydiff.previous",
    "when": "editorTextFocus && !textCompareEditorActive"
  },
  {
    "key": "ctrl+shift+alt+s",
    "command": "workbench.action.files.saveFiles"
  },
  {
    "key": "ctrl+alt+p",
    "command": "workbench.action.experimental.quickTextSearch"
  },
  {
    "key": "shift+cmd+/",
    "command": "workbench.action.focusAuxiliaryBar"
  },
  {
    "key": "shift+alt+i",
    "command": "references-view.findImplementations"
  },
  {
    "key": "alt+r",
    "command": "editor.action.goToReferences",
    "when": "editorHasReferenceProvider && !inReferenceSearchEditor && !isInEmbeddedEditor"
  },
  {
    "key": "shift+alt+r",
    "command": "references-view.findReferences",
    "when": "editorHasReferenceProvider"
  },
  {
    "key": "shift+alt+f12",
    "command": "-references-view.findReferences",
    "when": "editorHasReferenceProvider"
  },
  {
    "key": "alt+i",
    "command": "editor.action.goToImplementation",
    "when": "editorHasImplementationProvider"
  },
  {
    "key": "ctrl+; t",
    "command": "go.toggle.test.file"
  },
  {
    "key": "ctrl+alt+h",
    "command": "workbench.action.closePanel"
  },
  {
    "key": "ctrl+alt+r",
    "command": "go.test.file"
  },
  {
    "key": "ctrl+alt+p",
    "command": "workbench.action.togglePanel"
  },
  {
    "key": "cmd+j",
    "command": "-workbench.action.togglePanel"
  },
  {
    "key": "ctrl+alt+.",
    "command": "paredit.slurpSexpForward",
    "when": "editorLangId == 'clojure'"
  },
  {
    "key": "ctrl+x enter",
    "command": "calva.loadFile",
    "when": "calva:keybindingsEnabled && editorLangId == 'clojure'"
  },
  {
    "key": "ctrl+alt+c ctrl+;",
    "command": "calva.evaluateTopLevelFormAsComment",
    "when": "calva:keybindingsEnabled && editorTextFocus && editorLangId == 'clojure'"
  },
  {
    "key": "ctrl+x ctrl+t",
    "command": "calva.runTestUnderCursor",
    "when": "calva:connected && calva:keybindingsEnabled && editorLangId == 'clojure'"
  },
  {
    "key": "ctrl+x t n",
    "command": "calva.runNamespaceTests",
    "when": "calva:connected && calva:keybindingsEnabled && editorLangId == 'clojure'"
  },
  {
    "key": "ctrl+shift+l",
    "command": "editor.action.inlineSuggest.acceptNextWord",
    "when": "cppSuggestion && !editorReadonly || inlineSuggestionVisible && !editorReadonly"
  },
  {
    "key": "cmd+right",
    "command": "-editor.action.inlineSuggest.acceptNextWord",
    "when": "cppSuggestion && !editorReadonly || inlineSuggestionVisible && !editorReadonly"
  },
  {
    "key": "ctrl+x z g",
    "command": "cSpell.addWordToUserSettings"
  },
  {
    "key": "ctrl+i",
    "command": "-calva-fmt.tabIndent",
    "when": "calva:keybindingsEnabled && editorTextFocus && !editorReadOnly && !hasOtherSuggestions && !suggestWidgetVisible && editorLangId == 'clojure'"
  },
  {
    "key": "ctrl+alt+c ;",
    "command": "calva.evaluateSelectionAsComment",
    "when": "calva:keybindingsEnabled && editorTextFocus && editorLangId == 'clojure'"
  },
  {
    "key": "ctrl+alt+c c",
    "command": "-calva.evaluateSelectionAsComment",
    "when": "calva:keybindingsEnabled && editorTextFocus && editorLangId == 'clojure'"
  },
  {
    "key": "ctrl+alt+a",
    "command": "paredit.backwardSexp",
    "when": "editorLangId == 'clojure'"
  },
  {
    "key": "ctrl+alt+e",
    "command": "paredit.forwardSexp",
    "when": "editorLangId == 'clojure'"
  },
]
