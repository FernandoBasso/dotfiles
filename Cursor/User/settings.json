    "redhat.telemetry.enabled": true,
    "explorer.confirmDragAndDrop": false,
    "typescript.updateImportsOnFileMove.enabled": "never",
    "asciidoc.enableErrorDiagnostics": false,
    "terminal.external.osxExec": "iTerm.app",
    "plantuml.exportFormat": "svg",
    "editor.unicodeHighlight.allowedCharacters": {
        "‘": true,
        "’": true
    },
    "jestrunner.codeLens": [],
    "jestrunner.disableCodeLens": true,
    "AllAutocomplete.languageSpecialCharacters": {
        "css": "^[\\.#]",
        "scss": "^[\\.#]",
        "csv": "^[\\: ]"
    },
    "debug.javascript.autoAttachFilter": "onlyWithFlag",
    "editor.rulers": [
        72,
        80
    ],
    "haskell.manageHLS": "GHCup",
    "purescript.exportsCodeLens": false,
    "purescript.addNpmPath": true,
    "purescript.buildCommand": "npx spago build --purs-args --json-errors",
    "purescript.formatter": "purs-tidy",
    "purescript.pursExe": "./node_modules/purescript/purs.bin",
    "cSpell.minWordLength": 3,
    "cSpell.blockCheckingWhenAverageChunkSizeGreaterThan": 16384,
    "cSpell.blockCheckingWhenTextChunkSizeGreaterThan": 2048,
    "cSpell.dictionaryDefinitions": [],
    "cSpell.ignoreWords": [
        "YYYYMMDDH",
        "xyzxyx"
    ],
    "git.suggestSmartCommit": false,
    "window.titleBarStyle": "custom",
    "window.commandCenter": true,
    "cSpell.suggestionsTimeout": 15000,
    "cSpell.spellCheckDelayMs": 2048,
    "git.confirmSync": false,
    "javascript.updateImportsOnFileMove.enabled": "never",
    "[python]": {
        "editor.formatOnType": true
    },
    "html.autoClosingTags": false,
    "vim.useSystemClipboard": true,
    "typescript.suggest.autoImports": false,
    "javascript.suggest.autoImports": false,
    "diffEditor.renderSideBySide": false,
    "[typescriptreact]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    // "gitlens.plusFeatures.enabled": false,
    "gitlens.virtualRepositories.enabled": false,
    "gitlens.currentLine.pullRequests.enabled": false,
    "gitlens.statusBar.pullRequests.enabled": false,
    "gitlens.hovers.pullRequests.enabled": false,
    "gitlens.hovers.autolinks.enabled": false,
    "gitlens.hovers.currentLine.details": false,
    "hediet.vscode-drawio.resizeImages": null,
    "[html]": {
        "editor.defaultFormatter": "vscode.html-language-features"
    },
    "rubyLsp.enabledFeatures": {
        "codeActions": true,
        "diagnostics": false,
        "documentHighlights": true,
        "documentLink": true,
        "documentSymbols": true,
        "foldingRanges": true,
        "formatting": true,
        "hover": true,
        "inlayHint": false,
        "onTypeFormatting": true,
        "selectionRanges": true,
        "semanticHighlighting": true,
        "completion": true,
        "codeLens": true,
        "definition": true,
        "workspaceSymbol": true,
        "references": true
    },
    "editor.minimap.showSlider": "always",
    "files.watcherExclude": {
        "**/.bloop": true,
        "**/.metals": true,
        "**/.ammonite": true
    },
    "git.openRepositoryInParentFolders": "always",
    "[jsonc]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "markdown.copyFiles.destination": {
        "**/*.md": "./__assets/"
    },
    "security.workspace.trust.untrustedFiles": "open",
    "diffEditor.ignoreTrimWhitespace": false,
    "editor.inlayHints.enabled": "off",
    "go.buildFlags": [
        "-tags=unit,integration"
    ],
    "go.testTags": "unit,integration",
    "go.testExplorer.showDynamicSubtestsInEditor": true,
    "go.testFlags": [
        "-v",
        "-cover"
    ],
    "go.enableCodeLens": {
        "runtest": false
    },
    "files.autoSave": "onFocusChange",
    "editor.experimental.treeSitterTelemetry": true,
    "tooltitude.codeAction.runDebug": false,
    "chat.commandCenter.enabled": false,
    "go.toolsManagement.autoUpdate": true,
    "[javascriptreact]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "path-autocomplete.triggerOutsideStrings": true,
    "github.copilot.enable": {
        "*": false,
        "plaintext": false,
        "markdown": false,
        "scminput": false,
        "clojure": false
    },
    "[css]": {
        "editor.defaultFormatter": "vscode.css-language-features"
    },
    "calva.fmt.configPath": "CLOJURE-LSP",
    "git.blame.editorDecoration.enabled": false,
    "git.blame.statusBarItem.enabled": false,
    "cSpell.enabled": false,
    "editor.minimap.enabled": true,
    "gitlens.views.scm.grouped.views": {
        "commits": false,
        "branches": true,
        "remotes": true,
        "stashes": true,
        "tags": true,
        "worktrees": true,
        "contributors": true,
        "fileHistory": false,
        "repositories": true,
        "searchAndCompare": false,
        "launchpad": false
    },
    "editor.hover.enabled": false,
    "github.copilot.nextEditSuggestions.enabled": true
}
